{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": false,
  "subagent_depth": 4,
  "plugin": [
    "./plugins/opencode-models-discovery/src/index",
    "./plugins/caveman/src/index",
    "./plugins/opencode-plugin-md-expand/src/index"
  ],
  "small_model": "sewer-axonhub/deepseek-v4-flash",
  "permission": {
    "bash": {
      "*": "allow"
    },
    "task": {},
    "webfetch": "allow",
    "doom_loop": "deny",
    "github_*": "deny",
    "context7_*": "deny",
    "deepwiki_*": "deny",
    "external_directory": {
      "*": "ask",
      "/tmp/**": "allow",
      "/proc/**": "allow",
      "/sys/**": "allow",
      "/etc/**": "allow",
      "/nix/store/**": "allow",
      "/var/log/**": "allow",
      "/home/sewer/Downloads/**": "allow",
      "/home/sewer/Documents/**": "allow",
      "/home/sewer/projects/**": "allow",
      "/home/sewer/Project/**": "allow",
      "/home/sewer/projects/nixos-secrets/**": "deny"
    }
  },
  "agent": {
    "plan": {
      "permission": {
        "task": {
          "*": "deny",
          "general": "allow",
          "mcp-search": "allow",
          "codebase-explorer": "allow"
        },
        "skill": "deny",
        "external_directory": "allow"
      }
    },
    "build": {
      "permission": {
        "task": {
          "*": "deny",
          "general": "allow",
          "mcp-search": "allow",
          "codebase-explorer": "allow"
        },
        "skill": "deny",
        "external_directory": "allow"
      }
    },
    "general": {
      "permission": {
        "task": {
          "*": "deny",
          "mcp-search": "allow"
        }
      }
    },
    "explore": {
      "disable": true
    }
  },
  "mcp": {
    "github": {
      "type": "local",
      "command": [
        "docker",
        "run",
        "-i",
        "--rm",
        "-e",
        "GITHUB_PERSONAL_ACCESS_TOKEN={file:~/.secrets/github-token}",
        "ghcr.io/github/github-mcp-server"
      ],
      "enabled": true
    },
    "context7": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@upstash/context7-mcp"
      ],
      "enabled": true
    },
    "deepwiki": {
      "type": "remote",
      "url": "https://mcp.deepwiki.com/mcp",
      "enabled": true
    }
  },
  "provider": {
    "github-copilot": {
      "options": {
        "reasoningSummary": "concise"
      }
    },
    "sewer-axonhub": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Sewer AxonHub",
      "options": {
        "baseURL": "{file:~/.secrets/axonhub-url}",
        "apiKey": "{file:~/.secrets/axonhub-key}",
        "modelsDiscovery": {
          "enabled": true,
          "modelInfoFormat": "axonhub"
        }
      },
      "models": {
        "glm-5.3": {
          "name": "GLM 5.3",
          "reasoning": true,
          "variants": {
            "low": {
              "reasoningEffort": "low"
            },
            "high": {
              "reasoningEffort": "high"
            },
            "max": {
              "reasoningEffort": "max"
            }
          }
        },
        "glm-5.2": {
          "name": "GLM 5.2",
          "reasoning": true,
          "variants": {
            "high": {
              "reasoningEffort": "high"
            },
            "max": {
              "reasoningEffort": "max"
            }
          }
        },
        "gpt-5.6-luna": {
          "name": "GPT 5.6 Luna",
          "reasoning": true,
          "variants": {
            "none": {
              "reasoningEffort": "none"
            },
            "xhigh": {
              "reasoningEffort": "xhigh"
            },
            "max": {
              "reasoningEffort": "max"
            }
          }
        },
        "gpt-5.6-sol": {
          "name": "GPT 5.6 Sol",
          "reasoning": true,
          "variants": {
            "none": {
              "reasoningEffort": "none"
            },
            "xhigh": {
              "reasoningEffort": "xhigh"
            },
            "max": {
              "reasoningEffort": "max"
            }
          }
        },
        "gpt-5.6-terra": {
          "name": "GPT 5.6 Terra",
          "reasoning": true,
          "variants": {
            "none": {
              "reasoningEffort": "none"
            },
            "xhigh": {
              "reasoningEffort": "xhigh"
            },
            "max": {
              "reasoningEffort": "max"
            }
          }
        }
      }
    },
    "sewer-axonhub-work": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "AxonHub (Work Mode)",
      "options": {
        "baseURL": "{file:~/.secrets/axonhub-url}",
        "apiKey": "{file:~/.secrets/axonhub-work-key}",
        "modelsDiscovery": {
          "enabled": true,
          "modelInfoFormat": "axonhub"
        }
      },
      "models": {
        "claude-sonnet-5": {
          "name": "Claude Sonnet 5",
          "reasoning": true,
          "variants": {
            "xhigh": {
              "reasoningEffort": "xhigh"
            },
            "max": {
              "reasoningEffort": "max"
            }
          }
        },
        "claude-opus-4-8": {
          "name": "Claude Opus 4.8",
          "reasoning": true,
          "variants": {
            "xhigh": {
              "reasoningEffort": "xhigh"
            },
            "max": {
              "reasoningEffort": "max"
            }
          }
        },
        "claude-opus-4-7": {
          "name": "Claude Opus 4.7",
          "reasoning": true,
          "variants": {
            "xhigh": {
              "reasoningEffort": "xhigh"
            },
            "max": {
              "reasoningEffort": "max"
            }
          }
        },
        "claude-opus-5": {
          "name": "Claude Opus 5",
          "reasoning": true,
          "variants": {
            "xhigh": {
              "reasoningEffort": "xhigh"
            },
            "max": {
              "reasoningEffort": "max"
            }
          }
        },
        "claude-fable-5": {
          "name": "Claude Fable 5",
          "reasoning": true,
          "variants": {
            "xhigh": {
              "reasoningEffort": "xhigh"
            },
            "max": {
              "reasoningEffort": "max"
            }
          }
        },
        "gpt-5.6-luna": {
          "name": "GPT 5.6 Luna",
          "reasoning": true,
          "variants": {
            "none": {
              "reasoningEffort": "none"
            },
            "xhigh": {
              "reasoningEffort": "xhigh"
            },
            "max": {
              "reasoningEffort": "max"
            }
          }
        },
        "gpt-5.6-sol": {
          "name": "GPT 5.6 Sol",
          "reasoning": true,
          "variants": {
            "none": {
              "reasoningEffort": "none"
            },
            "xhigh": {
              "reasoningEffort": "xhigh"
            },
            "max": {
              "reasoningEffort": "max"
            }
          }
        },
        "gpt-5.6-terra": {
          "name": "GPT 5.6 Terra",
          "reasoning": true,
          "variants": {
            "none": {
              "reasoningEffort": "none"
            },
            "xhigh": {
              "reasoningEffort": "xhigh"
            },
            "max": {
              "reasoningEffort": "max"
            }
          }
        }
      }
    }
  },
  "experimental": {
    "disable_paste_summary": true
  },
  "tool_output": {
    "max_lines": 1000,
    "max_bytes": 40000
  },
  "compaction": {
    "auto": true,
    /* Remove contents of old tool calls. */
    "prune": false,
    "reserved": 12000
  },
  // Ignore certain locations in file watcher in OpenCode.
  "watcher": {
    "ignore": [
      ".git/**",
      "artifact/**",
      "artifacts/**",
      "node_modules/**",
      "dist/**",
      "build/**",
      "target/**",
      "coverage/**",
      ".venv/**",
      ".direnv/**",
      ".cache/**",
      "bin/**",
      "tmp/**"
    ]
  }
}