{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": false,
  "plugin": [
    "./plugins/opencode-models-discovery/src/index",
    "./plugins/caveman/src/index",
    "./plugins/opencode-plugin-md-expand/src/index"
  ],
  "small_model": "sewer-axonhub/deepseek-v4-flash",
  "permission": {
    "bash": {
      "*": "allow"
    },
    "task": {},
    "webfetch": "allow",
    "doom_loop": "deny",
    "github_*": "deny",
    "context7_*": "deny",
    "deepwiki_*": "deny",
    "external_directory": "allow"
  },
  "agent": {
    "plan": {
      "permission": {
        "task": {
          "*": "deny",
          "general": "allow",
          "mcp-search": "allow",
          "codebase-explorer": "allow"
        },
        "skill": "deny"
      }
    },
    "build": {
      "permission": {
        "task": {
          "*": "deny",
          "general": "allow",
          "mcp-search": "allow",
          "codebase-explorer": "allow"
        },
        "skill": "deny"
      }
    },
    "general": {
      "permission": {
        "task": {
          "*": "deny",
          "mcp-search": "allow"
        }
      }
    },
    "explore": {
      "disable": true
    }
  },
  "mcp": {
    "github": {
      "type": "local",
      "command": [
        "docker",
        "run",
        "-i",
        "--rm",
        "-e",
        "GITHUB_PERSONAL_ACCESS_TOKEN={file:~/.secrets/github-token}",
        "ghcr.io/github/github-mcp-server"
      ],
      "enabled": true
    },
    "context7": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@upstash/context7-mcp"
      ],
      "enabled": true
    },
    "deepwiki": {
      "type": "remote",
      "url": "https://mcp.deepwiki.com/mcp",
      "enabled": true
    }
  },
  "provider": {
    "github-copilot": {
      "options": {
        "reasoningSummary": "concise"
      }
    },
    "sewer-axonhub": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Sewer AxonHub",
      "options": {
        "baseURL": "{file:~/.secrets/axonhub-url}",
        "apiKey": "{file:~/.secrets/axonhub-key}",
        "modelsDiscovery": {
          "enabled": true,
          "modelInfoFormat": "models.dev"
        }
      }
    },
    "sewer-axonhub-work": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "AxonHub (Work Mode)",
      "options": {
        "baseURL": "{file:~/.secrets/axonhub-url}",
        "apiKey": "{file:~/.secrets/axonhub-work-key}",
        "modelsDiscovery": {
          "enabled": true,
          "modelInfoFormat": "models.dev"
        }
      }
    }
  },
  "experimental": {
    "disable_paste_summary": true
  }
}