{
  "$schema": "https://opencode.ai/v2/cli.json",
  "theme": {
    "name": "catppuccin"
  },
  "keybinds": {
    "command.palette.show": "ctrl+["
  },
  "plugins": [
    "oc-tps@latest"
  ],
  "scroll": {
    "speed": 1
  },
  "diffs": {
    "wrap": "word"
  },
  "session": {
    "sidebar": "hide",
    "scrollbar": false,
    "thinking": "show"
  },
  "animations": true
}
