{
  "$schema": "https://opencode.ai/v2/cli.json",
  "theme": {
    "name": "catppuccin"
  },
  "keybinds": {
    "command.palette.show": "ctrl+["
  },
  "scroll": {
    "speed": 1
  },
  "diffs": {
    "wrap": "word"
  },
  "session": {
    "sidebar": "hide",
    "scrollbar": false,
    "thinking": "show",
    "image_preview": false
  },
  "animations": true,
  "tabs": {
    "layout": "horizontal",
    "indicators": "status",
    "scope": "cwd",
    "mode": "auto"
  }
}
